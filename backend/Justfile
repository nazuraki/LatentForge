# LatentForge backend — API server (module of the root Justfile: `just backend <recipe>`)

# List available recipes
default:
    @just --list

# Install dependencies
install:
    npm install

# Run (requires .env)
run:
    npm run start

# Run in dev mode
dev:
    npm run dev

# Run all checks (lint + typecheck + test)
check: lint typecheck test

# Lint (read-only)
lint:
    npm run lint

# Fix lint issues
fix:
    npm run fix

# Type-check
typecheck:
    npm run typecheck

# Run tests
test:
    npm run test

# Remove node_modules
clean:
    rm -rf node_modules

# Reinstall from scratch
fresh: clean install
